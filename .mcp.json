{
	"mcpServers": {
		"chroma": {
			"command": "uvx",
			"args": [
				"chroma-mcp",
				"--client-type",
				"persistent",
				"--data-dir",
				"chroma.db"
			]
		},
		"mcp-tasks": {
			"command": "npx",
			"args": ["-y", "mcp-tasks"],
			"env": {
				"STATUS_WIP": "In Progress",
				"STATUS_TODO": "To Do",
				"STATUS_DONE": "Done",
				"STATUS_REMINDERS": "Reminders",
				"STATUS_NOTES": "Notes",
				"STATUSES": "In Progress,To Do,Done,Backlog,Reminders,Notes",
				"AUTO_WIP": "true",
				"PREFIX_TOOLS": "true",
				"KEEP_DELETED": "true",
				"TRANSPORT": "stdio",
				"INSTRUCTIONS": "Use mcp-tasks tools when the user mentions new or updated tasks"
			}
		}
	}
}